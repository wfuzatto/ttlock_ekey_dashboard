Options -Indexes
DirectoryIndex index.php
<FilesMatch "^(config\.(local|private|example)\.php|\.env.*|schema\.sql|README\.md|\.gitignore|ttlock_ekey_config\.php)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
